{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
        "allowJs": false,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        // vite.config.ts imports hostShared.ts as Node.js runs it
        "allowImportingTsExtensions": true,
        "jsx": "react-jsx",
        "types": ["vite/client", "@iobroker/types"],
        // the phone in ../src-shared has no node_modules of its own: it is compiled with the packages of this plugin
        "paths": {
            "react": ["./node_modules/@types/react"],
            "react/*": ["./node_modules/@types/react/*"],
            "@mui/material": ["./node_modules/@mui/material"],
            "@mui/material/*": ["./node_modules/@mui/material/*"],
            "@mui/icons-material": ["./node_modules/@mui/icons-material"],
            "@mui/icons-material/*": ["./node_modules/@mui/icons-material/*"],
            "@iobroker/gui-components": ["./node_modules/@iobroker/gui-components"]
        }
    },
    "include": ["src", "vite.config.ts", "hostShared.ts", "../src-shared/src"]
}
