{
    "compilerOptions": {
        "target": "es2020",
        "lib": ["dom", "dom.iterable", "es2022"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "types": []
    },
    "include": ["./**/*.ts", "./**/*.tsx"]
}
