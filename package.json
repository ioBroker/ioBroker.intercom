{
    "name": "iobroker.asterisk-docker",
    "version": "0.0.1",
    "description": "Asterisk PBX with WebRTC in Docker, configured completely from ioBroker admin",
    "author": "bluefox <dogafox@gmail.com>",
    "contributors": [
        "bluefox <dogafox@gmail.com>"
    ],
    "homepage": "https://github.com/ioBroker/ioBroker.asterisk-docker",
    "repository": {
        "type": "git",
        "url": "https://github.com/ioBroker/ioBroker.asterisk-docker"
    },
    "engines": {
        "node": ">=22.19.0"
    },
    "keywords": [
        "ioBroker",
        "asterisk",
        "webrtc",
        "sip",
        "pbx",
        "docker"
    ],
    "dependencies": {
        "@iobroker/adapter-core": "^3.4.3",
        "@iobroker/plugin-docker": "^1.2.1",
        "node-forge": "^1.4.0"
    },
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
        "@alcalzone/release-script-plugin-license": "^5.2.2",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/testing": "^6.3.0",
        "@iobroker/types": "^7.2.5",
        "@mui/icons-material": "^9.4.0",
        "@mui/material": "^9.4.0",
        "@tsconfig/node22": "^22.0.6",
        "@types/node": "^22.20.5",
        "@types/node-forge": "^1.3.14",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "esbuild": "^0.28.2",
        "jssip": "3.13.8",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "typescript": "~6.0.3"
    },
    "bugs": {
        "url": "https://github.com/ioBroker/ioBroker.asterisk-docker/issues"
    },
    "main": "build/main.js",
    "files": [
        "admin/",
        "build/",
        "docker-compose.yaml",
        "io-package.json",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json && npm run build:www",
        "check:ts": "tsc -p tsconfig.json --noEmit && tsc -p src-www/tsconfig.json",
        "lint": "eslint -c eslint.config.mjs",
        "test:unit": "mocha --config test/mocharc.custom.json \"test/unit/*.test.js\" --exit",
        "test:package": "mocha --config test/mocharc.custom.json test/package.js --exit",
        "test:integration": "mocha --config test/mocharc.custom.json test/integration.js --exit",
        "test": "npm run build && npm run test:unit && npm run test:package",
        "prepublishOnly": "npm run build",
        "release": "release-script",
        "release-patch": "release-script patch --yes",
        "release-minor": "release-script minor --yes",
        "release-major": "release-script major --yes",
        "update-packages": "npx -y npm-check-updates --upgrade",
        "build:www": "esbuild src-www/index.tsx --bundle --minify --format=iife --platform=browser --target=es2020 --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --legal-comments=eof --outfile=build/static/phone.min.js"
    },
    "license": "MIT"
}
