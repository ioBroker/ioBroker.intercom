{
    "i18n": true,
    "type": "tabs",
    "items": {
        "_subscribers": {
            "type": "panel",
            "label": "Subscribers",
            "items": {
                "subscribers": {
                    "type": "table",
                    "xs": 12,
                    "uniqueColumns": [
                        "extension"
                    ],
                    "encryptedAttributes": [
                        "password"
                    ],
                    "showSecondAddAt": 5,
                    "export": true,
                    "items": [
                        {
                            "type": "checkbox",
                            "attr": "enabled",
                            "title": "Active",
                            "width": 60,
                            "default": true
                        },
                        {
                            "type": "text",
                            "attr": "extension",
                            "title": "Number",
                            "width": 120,
                            "filter": true,
                            "sort": true,
                            "default": "",
                            "validator": "/^[0-9]{2,6}$/.test(data.extension) && !(globalData.echoTest && data.extension === '600')",
                            "validatorErrorText": "2 to 6 digits, 600 is reserved for the echo test",
                            "validatorNoSaveOnError": true
                        },
                        {
                            "type": "text",
                            "attr": "name",
                            "title": "Name",
                            "filter": true,
                            "sort": true,
                            "default": "",
                            "maxLength": 64
                        },
                        {
                            "type": "select",
                            "attr": "kind",
                            "title": "Type",
                            "width": 160,
                            "default": "webrtc",
                            "options": [
                                {
                                    "label": "WebRTC (browser, app)",
                                    "value": "webrtc"
                                },
                                {
                                    "label": "SIP (phone, intercom)",
                                    "value": "sip"
                                }
                            ]
                        },
                        {
                            "type": "number",
                            "attr": "maxContacts",
                            "title": "Devices",
                            "tooltip": "tooltip_maxContacts",
                            "width": 90,
                            "min": 1,
                            "max": 20,
                            "default": 5
                        },
                        {
                            "type": "password",
                            "attr": "password",
                            "title": "Password (min. 4 characters)",
                            "width": 200,
                            "visible": true,
                            "default": "",
                            "validator": "!data.password || data.password.length >= 4",
                            "validatorErrorText": "At least 4 characters. Leave empty to generate one",
                            "validatorNoSaveOnError": true
                        },
                        {
                            "type": "textSendTo",
                            "attr": "_status",
                            "title": "Status",
                            "width": 240,
                            "container": "text",
                            "command": "getSubscriberStatus",
                            "jsonData": "{\"extension\": \"${data.extension}\"}",
                            "alsoDependsOn": [
                                "extension"
                            ]
                        }
                    ]
                },
                "_hintPassword": {
                    "type": "staticText",
                    "newLine": true,
                    "xs": 12,
                    "text": "hint_password"
                },
                "_wssUrl": {
                    "type": "pattern",
                    "newLine": true,
                    "xs": 12,
                    "md": 6,
                    "label": "WebSocket URL for WebRTC clients",
                    "copyToClipboard": true,
                    "pattern": "wss://${(data.certHosts || [])[0] || location.hostname}:${data.wssPort}/ws"
                },
                "_sipServer": {
                    "type": "pattern",
                    "xs": 12,
                    "md": 6,
                    "label": "SIP server for phones (UDP)",
                    "copyToClipboard": true,
                    "hidden": "!(data.subscribers || []).some(s => s.enabled && s.kind === 'sip')",
                    "pattern": "${(data.certHosts || [])[0] || location.hostname}:5060"
                },
                "_testPage": {
                    "type": "staticLink",
                    "newLine": true,
                    "xs": 12,
                    "hidden": "!data.testPage",
                    "label": "Open the WebRTC test page",
                    "href": "https://${(data.certHosts || [])[0] || location.hostname}:${data.wssPort}/static/test.html",
                    "target": "_blank",
                    "button": true,
                    "variant": "outlined",
                    "icon": "web"
                }
            }
        },
        "_groups": {
            "type": "panel",
            "label": "Groups",
            "items": {
                "_hintGroups": {
                    "type": "staticText",
                    "xs": 12,
                    "text": "hint_groups"
                },
                "groups": {
                    "type": "table",
                    "newLine": true,
                    "xs": 12,
                    "uniqueColumns": [
                        "extension"
                    ],
                    "export": true,
                    "items": [
                        {
                            "type": "checkbox",
                            "attr": "enabled",
                            "title": "Active",
                            "width": 60,
                            "default": true
                        },
                        {
                            "type": "text",
                            "attr": "extension",
                            "title": "Number",
                            "width": 120,
                            "default": "",
                            "validator": "/^[0-9]{2,6}$/.test(data.extension) && !(globalData.echoTest && data.extension === '600') && !(globalData.subscribers || []).some(s => s && s.extension === data.extension)",
                            "validatorErrorText": "2 to 6 digits, not the number of a subscriber or of the echo test",
                            "validatorNoSaveOnError": true
                        },
                        {
                            "type": "text",
                            "attr": "name",
                            "title": "Name",
                            "width": 160,
                            "default": "",
                            "maxLength": 64
                        },
                        {
                            "type": "selectSendTo",
                            "attr": "members",
                            "title": "Members",
                            "multiple": true,
                            "noTranslation": true,
                            "default": [],
                            "command": "getSubscriberOptions",
                            "jsonData": "{\"subscribers\": ${JSON.stringify((globalData.subscribers || []).filter(s => s && s.enabled && s.extension).map(s => [s.extension, s.name || '']))}}",
                            "validator": "Array.isArray(data.members) ? data.members.length > 0 : !!data.members",
                            "validatorErrorText": "Select at least one subscriber",
                            "validatorNoSaveOnError": true
                        },
                        {
                            "type": "number",
                            "attr": "ringTime",
                            "title": "Ring time (s)",
                            "width": 110,
                            "min": 5,
                            "max": 300,
                            "default": 30
                        }
                    ]
                }
            }
        },
        "_cameras": {
            "type": "panel",
            "label": "Cameras",
            "items": {
                "_hintCameras": {
                    "type": "staticText",
                    "xs": 12,
                    "text": "hint_cameras"
                },
                "cameras": {
                    "type": "table",
                    "newLine": true,
                    "xs": 12,
                    "uniqueColumns": [
                        "name"
                    ],
                    "encryptedAttributes": [
                        "password"
                    ],
                    "export": true,
                    "items": [
                        {
                            "type": "checkbox",
                            "attr": "enabled",
                            "title": "Active",
                            "width": 60,
                            "default": true
                        },
                        {
                            "type": "text",
                            "attr": "name",
                            "title": "Name",
                            "width": 140,
                            "default": "",
                            "maxLength": 32,
                            "validator": "/^[a-z0-9_-]+$/.test(data.name || '')",
                            "validatorErrorText": "Only a-z, 0-9, _ and -",
                            "validatorNoSaveOnError": true
                        },
                        {
                            "type": "text",
                            "attr": "url",
                            "title": "Snapshot URL",
                            "default": "",
                            "validator": "/^https?:\\/\\/./.test(data.url || '')",
                            "validatorErrorText": "http:// or https:// URL",
                            "validatorNoSaveOnError": true
                        },
                        {
                            "type": "select",
                            "attr": "auth",
                            "title": "Authentication",
                            "width": 170,
                            "default": "none",
                            "options": [
                                {
                                    "label": "None",
                                    "value": "none"
                                },
                                {
                                    "label": "User and password",
                                    "value": "basic"
                                },
                                {
                                    "label": "API key (UniFi Protect)",
                                    "value": "apikey"
                                },
                                {
                                    "label": "Bearer token",
                                    "value": "bearer"
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "attr": "user",
                            "title": "User",
                            "width": 120,
                            "default": ""
                        },
                        {
                            "type": "password",
                            "attr": "password",
                            "title": "Password / key",
                            "width": 160,
                            "visible": true,
                            "default": ""
                        },
                        {
                            "type": "checkbox",
                            "attr": "insecure",
                            "title": "Self-signed certificate",
                            "width": 90,
                            "default": true
                        },
                        {
                            "type": "number",
                            "attr": "interval",
                            "title": "During calls (s)",
                            "width": 100,
                            "min": 0.5,
                            "max": 60,
                            "step": 0.5,
                            "default": 1
                        },
                        {
                            "type": "number",
                            "attr": "idleInterval",
                            "title": "Without call (s)",
                            "width": 100,
                            "min": 0,
                            "max": 3600,
                            "default": 0
                        }
                    ]
                }
            }
        },
        "_certificate": {
            "type": "panel",
            "label": "Certificate",
            "items": {
                "certSource": {
                    "type": "select",
                    "xs": 12,
                    "md": 6,
                    "label": "Certificate source",
                    "options": [
                        {
                            "label": "Self-signed certificate of the adapter",
                            "value": "self"
                        },
                        {
                            "label": "Certificate of ioBroker (e.g. from ACME)",
                            "value": "iobroker"
                        }
                    ]
                },
                "_hintPinning": {
                    "type": "staticText",
                    "newLine": true,
                    "xs": 12,
                    "text": "hint_pinning"
                },
                "certHosts": {
                    "type": "chips",
                    "newLine": true,
                    "xs": 12,
                    "md": 8,
                    "hidden": "data.certSource === 'iobroker'",
                    "label": "Host names and IP addresses in the certificate",
                    "help": "help_cert_hosts"
                },
                "_getHosts": {
                    "type": "sendTo",
                    "xs": 12,
                    "md": 4,
                    "hidden": "data.certSource === 'iobroker'",
                    "command": "getHostAddresses",
                    "label": "Detect addresses",
                    "variant": "outlined",
                    "icon": "search",
                    "useNative": true
                },
                "_generateCert": {
                    "type": "sendTo",
                    "newLine": true,
                    "xs": 12,
                    "md": 4,
                    "hidden": "data.certSource === 'iobroker'",
                    "command": "generateCert",
                    "jsonData": "{\"certHosts\": \"${data.certHosts}\"}",
                    "label": "Regenerate certificate",
                    "variant": "contained",
                    "icon": "auth",
                    "useNative": true,
                    "showProcess": true,
                    "timeout": 30000,
                    "confirm": {
                        "title": "Regenerate certificate",
                        "text": "confirm_regenerate",
                        "ok": "Regenerate",
                        "cancel": "Cancel",
                        "type": "warning"
                    }
                },
                "certFingerprint": {
                    "type": "text",
                    "newLine": true,
                    "xs": 12,
                    "md": 8,
                    "hidden": "data.certSource === 'iobroker'",
                    "label": "SHA-256 fingerprint",
                    "readOnly": true,
                    "copyToClipboard": true
                },
                "_fingerprintQr": {
                    "type": "qrCode",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "hidden": "data.certSource === 'iobroker' || !data.certFingerprint",
                    "data": "${data.certFingerprint}",
                    "size": 180,
                    "level": "M"
                },
                "certIobPublic": {
                    "type": "certificate",
                    "certType": "public",
                    "newLine": true,
                    "xs": 12,
                    "md": 4,
                    "hidden": "data.certSource !== 'iobroker'",
                    "label": "Public certificate"
                },
                "certIobPrivate": {
                    "type": "certificate",
                    "certType": "private",
                    "xs": 12,
                    "md": 4,
                    "hidden": "data.certSource !== 'iobroker'",
                    "label": "Private key"
                },
                "certIobChained": {
                    "type": "certificate",
                    "certType": "chained",
                    "xs": 12,
                    "md": 4,
                    "hidden": "data.certSource !== 'iobroker'",
                    "label": "Chained certificate"
                },
                "_iobFingerprint": {
                    "type": "textSendTo",
                    "newLine": true,
                    "xs": 12,
                    "hidden": "data.certSource !== 'iobroker' || !data.certIobPublic",
                    "label": "SHA-256 fingerprint",
                    "container": "text",
                    "copyToClipboard": true,
                    "command": "getIobFingerprint",
                    "jsonData": "{\"certIobPublic\": \"${data.certIobPublic}\"}",
                    "alsoDependsOn": [
                        "certIobPublic"
                    ]
                }
            }
        },
        "_asterisk": {
            "type": "panel",
            "label": "Asterisk",
            "items": {
                "dockerEnabled": {
                    "type": "checkDocker",
                    "xs": 12,
                    "label": "Run Asterisk in Docker (managed by this adapter)",
                    "help": "help_docker"
                },
                "dockerStopOnUnload": {
                    "type": "checkbox",
                    "newLine": true,
                    "xs": 12,
                    "md": 6,
                    "hidden": "!data.dockerEnabled",
                    "label": "Stop the container when the instance stops"
                },
                "_hintDocker": {
                    "type": "staticText",
                    "newLine": true,
                    "xs": 12,
                    "hidden": "!!data.dockerEnabled",
                    "text": "hint_external"
                },
                "configDir": {
                    "type": "text",
                    "newLine": true,
                    "xs": 12,
                    "md": 8,
                    "label": "Configuration directory",
                    "help": "help_config_dir"
                },
                "amiHost": {
                    "type": "text",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "label": "AMI host"
                },
                "amiPort": {
                    "type": "number",
                    "xs": 12,
                    "sm": 6,
                    "md": 2,
                    "min": 1,
                    "max": 65535,
                    "label": "AMI port"
                },
                "wssPort": {
                    "type": "port",
                    "xs": 12,
                    "sm": 6,
                    "md": 2,
                    "min": 1,
                    "label": "WSS port"
                },
                "rtpStart": {
                    "type": "number",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 2,
                    "min": 1024,
                    "max": 65535,
                    "label": "RTP port from"
                },
                "rtpEnd": {
                    "type": "number",
                    "xs": 12,
                    "sm": 6,
                    "md": 2,
                    "min": 1024,
                    "max": 65535,
                    "label": "RTP port to",
                    "validator": "Number(data.rtpEnd) > Number(data.rtpStart)",
                    "validatorErrorText": "Must be greater than the start port"
                },
                "codecs": {
                    "type": "select",
                    "multiple": true,
                    "xs": 12,
                    "md": 4,
                    "label": "Codecs",
                    "help": "help_codecs",
                    "options": [
                        {
                            "label": "Opus",
                            "value": "opus"
                        },
                        {
                            "label": "G.722 (HD)",
                            "value": "g722"
                        },
                        {
                            "label": "G.711 µ-law (ulaw)",
                            "value": "ulaw"
                        },
                        {
                            "label": "G.711 A-law (alaw)",
                            "value": "alaw"
                        }
                    ]
                },
                "videoCodecs": {
                    "type": "select",
                    "multiple": true,
                    "xs": 12,
                    "md": 4,
                    "label": "Video codecs",
                    "help": "help_video_codecs",
                    "options": [
                        {
                            "label": "VP8",
                            "value": "vp8"
                        },
                        {
                            "label": "H.264",
                            "value": "h264"
                        },
                        {
                            "label": "VP9",
                            "value": "vp9"
                        }
                    ]
                },
                "stunServer": {
                    "type": "text",
                    "newLine": true,
                    "xs": 12,
                    "md": 4,
                    "label": "STUN server",
                    "placeholder": "stun.l.google.com:19302",
                    "help": "help_stun"
                },
                "externalAddress": {
                    "type": "text",
                    "xs": 12,
                    "md": 4,
                    "label": "External address",
                    "help": "help_external_address"
                },
                "iceDenylist": {
                    "type": "text",
                    "xs": 12,
                    "md": 4,
                    "label": "Networks excluded from ICE",
                    "help": "help_ice_denylist"
                },
                "echoTest": {
                    "type": "checkbox",
                    "newLine": true,
                    "xs": 12,
                    "md": 6,
                    "label": "Echo test on extension 600"
                },
                "testPage": {
                    "type": "checkbox",
                    "xs": 12,
                    "md": 6,
                    "label": "Provide the WebRTC test page"
                },
                "asteriskLogLevel": {
                    "type": "select",
                    "newLine": true,
                    "xs": 12,
                    "md": 6,
                    "label": "Asterisk log in ioBroker",
                    "help": "help_asterisk_log",
                    "options": [
                        {
                            "label": "Off",
                            "value": "none"
                        },
                        {
                            "label": "Errors and warnings",
                            "value": "errors"
                        },
                        {
                            "label": "Plus notices",
                            "value": "notice"
                        },
                        {
                            "label": "Plus call flow (verbose)",
                            "value": "verbose"
                        },
                        {
                            "label": "Everything (debug)",
                            "value": "debug"
                        }
                    ]
                },
                "sipTrace": {
                    "type": "checkbox",
                    "xs": 12,
                    "md": 6,
                    "label": "Log SIP messages",
                    "help": "help_sip_trace",
                    "hidden": "data.asteriskLogLevel === 'none'"
                },
                "_reload": {
                    "type": "sendTo",
                    "newLine": true,
                    "xs": 12,
                    "md": 4,
                    "command": "reload",
                    "label": "Write configuration and reload Asterisk",
                    "variant": "outlined",
                    "icon": "send",
                    "showProcess": true,
                    "timeout": 30000,
                    "result": {
                        "ok": "Asterisk reloaded"
                    }
                }
            }
        }
    }
}
