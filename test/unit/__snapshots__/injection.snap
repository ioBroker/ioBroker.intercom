===== start.sh =====
#!/bin/bash
# generated by ioBroker asterisk-docker – do not edit
set -u
DIR=/etc/asterisk/iobroker

if ! command -v asterisk >/dev/null 2>&1; then
    echo "[iobroker] Installing Asterisk. This takes a few minutes on the first start..."
    export DEBIAN_FRONTEND=noninteractive
    if ! (apt-get update && apt-get install -y --no-install-recommends \
            asterisk asterisk-modules asterisk-core-sounds-en-gsm ca-certificates); then
        echo "[iobroker] Installation of Asterisk failed. Retrying in 60 seconds."
        sleep 60
        exit 1
    fi
    # Not all distributions ship an opus codec module - it is optional
    apt-get install -y --no-install-recommends asterisk-opus >/dev/null 2>&1 || true
    rm -rf /var/lib/apt/lists/*
fi

# The configuration files of Asterisk only include the generated files
for f in http pjsip rtp extensions manager modules; do
    echo "#include iobroker/$f.conf" > /etc/asterisk/$f.conf
done
# Asterisk runs as root in the container: it must read the key files of the host (mode 0600)
sed -i -E 's/^\s*(runuser|rungroup)/;\1/' /etc/asterisk/asterisk.conf

# Static files (test page) are served from the generated directory
mkdir -p "$DIR/static-http"
rm -rf /usr/share/asterisk/static-http
ln -s "$DIR/static-http" /usr/share/asterisk/static-http

echo "[iobroker] Starting Asterisk $(asterisk -V 2>/dev/null)"
exec asterisk -f -vvv

===== static-http/test.html =====
<!doctype html>
<!-- generated by ioBroker asterisk-docker – do not edit -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ioBroker PBX test</title>
<style>
    :root { color-scheme: light dark; }
    body { font-family: system-ui, sans-serif; max-width: 520px; margin: 24px auto; padding: 0 16px; }
    fieldset { border: 1px solid #8884; border-radius: 8px; margin-bottom: 16px; }
    label { display: block; margin: 8px 0 2px; font-size: 0.9em; }
    input { width: 100%; box-sizing: border-box; padding: 8px; font-size: 1em; }
    button { padding: 8px 16px; margin: 12px 8px 0 0; font-size: 1em; cursor: pointer; }
    #status { font-weight: bold; }
    #log { font-family: monospace; font-size: 0.8em; white-space: pre-wrap; max-height: 240px; overflow: auto; background: #8881; padding: 8px; border-radius: 6px; }
</style>
</head>
<body>
<h2>ioBroker PBX - WebRTC test</h2>
<fieldset>
    <legend>Login</legend>
    <label for="ext">Extension</label><input id="ext" autocomplete="username">
    <label for="pw">Password</label><input id="pw" type="password" autocomplete="current-password">
    <button id="login">Register</button><button id="logout" disabled>Unregister</button>
</fieldset>
<fieldset>
    <legend>Call</legend>
    <label for="target">Number</label><input id="target" value="600">
    <button id="call" disabled>Call</button><button id="answer" disabled>Answer</button><button id="hangup" disabled>Hang up</button>
</fieldset>
<p>Status: <span id="status">not registered</span></p>
<audio id="remote" autoplay></audio>
<div id="log"></div>
<script type="module">
import JsSIP from 'https://cdn.jsdelivr.net/npm/jssip@3.13.8/+esm';

const $ = id => document.getElementById(id);
const host = location.hostname;
const wssUrl = 'wss://' + location.host + '/ws';
let ua = null;
let session = null;

function log(text) {
    $('log').textContent = new Date().toLocaleTimeString() + ' ' + text + '\n' + $('log').textContent;
}
function status(text) {
    $('status').textContent = text;
    log(text);
}
function buttons() {
    const registered = !!ua && ua.isRegistered();
    $('login').disabled = !!ua;
    $('logout').disabled = !ua;
    $('call').disabled = !registered || !!session;
    $('hangup').disabled = !session;
    $('answer').disabled = !session || session.direction !== 'incoming' || session.isEstablished();
}

function attachSession(s) {
    session = s;
    s.on('peerconnection', e => {
        e.peerconnection.addEventListener('track', ev => { $('remote').srcObject = ev.streams[0]; });
    });
    s.on('progress', () => status('ringing'));
    s.on('confirmed', () => { status('in call'); buttons(); });
    s.on('ended', () => { session = null; status('call ended'); buttons(); });
    s.on('failed', e => { session = null; status('call failed: ' + e.cause); buttons(); });
    if (s.connection) {
        s.connection.addEventListener('track', ev => { $('remote').srcObject = ev.streams[0]; });
    }
    buttons();
}

$('login').onclick = () => {
    const ext = $('ext').value.trim();
    const socket = new JsSIP.WebSocketInterface(wssUrl);
    ua = new JsSIP.UA({
        sockets: [socket],
        uri: 'sip:' + ext + '@' + host,
        authorization_user: ext,
        password: $('pw').value,
        realm: 'iobroker',
        register: true,
        session_timers: false,
    });
    ua.on('connected', () => log('WebSocket connected to ' + wssUrl));
    ua.on('disconnected', () => log('WebSocket disconnected'));
    ua.on('registered', () => { status('registered as ' + ext); buttons(); });
    ua.on('unregistered', () => { status('not registered'); buttons(); });
    ua.on('registrationFailed', e => { status('registration failed: ' + e.cause); buttons(); });
    ua.on('newRTCSession', e => {
        if (session) {
            e.session.terminate({ status_code: 486 });
            return;
        }
        attachSession(e.session);
        if (e.originator === 'remote') {
            status('incoming call from ' + e.request.from.uri.user);
        }
    });
    ua.start();
    buttons();
};

$('logout').onclick = () => {
    ua && ua.stop();
    ua = null;
    session = null;
    status('not registered');
    buttons();
};

const callOptions = {
    mediaConstraints: { audio: true, video: false },
    pcConfig: { iceServers: [] },
    rtcOfferConstraints: { offerToReceiveAudio: true, offerToReceiveVideo: false },
};

$('call').onclick = () => {
    const target = $('target').value.trim();
    if (target) {
        ua.call('sip:' + target + '@' + host, callOptions);
        status('calling ' + target);
    }
};
$('answer').onclick = () => session && session.answer(callOptions);
$('hangup').onclick = () => session && session.terminate();
buttons();
</script>
</body>
</html>
