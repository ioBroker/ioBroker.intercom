===== pjsip.conf =====
; generated by ioBroker intercom – do not edit

[global]
type=global
default_realm=iobroker
user_agent=ioBroker PBX

[transport-wss]
type=transport
protocol=wss
bind=0.0.0.0
external_media_address=1.2.3.4allowall
external_signaling_address=1.2.3.4allowall
local_net=10.0.0.0/8
local_net=172.16.0.0/12
local_net=192.168.0.0/16

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
external_media_address=1.2.3.4allowall
external_signaling_address=1.2.3.4allowall
local_net=10.0.0.0/8
local_net=172.16.0.0/12
local_net=192.168.0.0/16

; ---- templates ----
[webrtc-endpoint](!)
type=endpoint
context=iobroker
transport=transport-wss
disallow=all
allow=opus,ulaw,alaw
webrtc=yes
dtls_auto_generate_cert=yes
direct_media=no
allow_subscribe=no

[sip-endpoint](!)
type=endpoint
context=iobroker
transport=transport-udp
disallow=all
allow=ulaw,alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
allow_subscribe=no

[aor-template](!)
type=aor
max_contacts=5
remove_existing=yes
remove_unavailable=yes
qualify_frequency=30

[auth-template](!)
type=auth
auth_type=md5
realm=iobroker

; ---- 101 (webrtc) ----
[101](webrtc-endpoint)
auth=101
aors=101
callerid="Evilanonymoustype=endpointcontext=iobroker" <101>

[101](aor-template)

[101](auth-template)
username=101
md5_cred=015e6249785d0bce032931f4b28fe2b0

; ---- 201 (sip) ----
[201](sip-endpoint)
auth=201
aors=201
callerid="acomment 999 sallow=all" <201>

[201](aor-template)

[201](auth-template)
