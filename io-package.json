{
    "common": {
        "name": "intercom",
        "version": "0.1.0",
        "news": {
            "0.1.0": {
                "en": "Initial release",
                "de": "Erstveröffentlichung",
                "ru": "Первый выпуск",
                "pt": "Lançamento inicial",
                "nl": "Eerste uitgave",
                "fr": "Version initiale",
                "it": "Prima versione",
                "es": "Versión inicial",
                "pl": "Pierwsze wydanie",
                "uk": "Перший випуск",
                "zh-cn": "首次发布"
            }
        },
        "titleLang": {
            "en": "Asterisk PBX with WebRTC (Docker)",
            "de": "Asterisk-Telefonanlage mit WebRTC (Docker)",
            "ru": "АТС Asterisk с WebRTC (Docker)",
            "pt": "PBX Asterisk com WebRTC (Docker)",
            "nl": "Asterisk-telefooncentrale met WebRTC (Docker)",
            "fr": "PBX Asterisk avec WebRTC (Docker)",
            "it": "Centralino Asterisk con WebRTC (Docker)",
            "es": "Centralita Asterisk con WebRTC (Docker)",
            "pl": "Centrala Asterisk z WebRTC (Docker)",
            "uk": "АТС Asterisk з WebRTC (Docker)",
            "zh-cn": "带 WebRTC 的 Asterisk 电话交换机 (Docker)"
        },
        "desc": {
            "en": "Runs Asterisk in Docker and configures it completely from ioBroker: subscribers, certificate, WebRTC over WSS",
            "de": "Startet Asterisk in Docker und konfiguriert es vollständig aus ioBroker: Teilnehmer, Zertifikat, WebRTC über WSS",
            "ru": "Запускает Asterisk в Docker и полностью настраивает его из ioBroker: абоненты, сертификат, WebRTC через WSS",
            "pt": "Executa o Asterisk no Docker e o configura totalmente a partir do ioBroker: assinantes, certificado, WebRTC via WSS",
            "nl": "Draait Asterisk in Docker en configureert het volledig vanuit ioBroker: deelnemers, certificaat, WebRTC via WSS",
            "fr": "Exécute Asterisk dans Docker et le configure entièrement depuis ioBroker : abonnés, certificat, WebRTC via WSS",
            "it": "Esegue Asterisk in Docker e lo configura completamente da ioBroker: utenti, certificato, WebRTC tramite WSS",
            "es": "Ejecuta Asterisk en Docker y lo configura completamente desde ioBroker: abonados, certificado, WebRTC por WSS",
            "pl": "Uruchamia Asteriska w Dockerze i konfiguruje go w całości z ioBrokera: abonenci, certyfikat, WebRTC przez WSS",
            "uk": "Запускає Asterisk у Docker і повністю налаштовує його з ioBroker: абоненти, сертифікат, WebRTC через WSS",
            "zh-cn": "在 Docker 中运行 Asterisk，并完全通过 ioBroker 进行配置：用户、证书、基于 WSS 的 WebRTC"
        },
        "authors": [
            "bluefox <dogafox@gmail.com>"
        ],
        "keywords": [
            "asterisk",
            "webrtc",
            "sip",
            "pbx",
            "voip",
            "docker",
            "intercom"
        ],
        "licenseInformation": {
            "type": "free",
            "license": "MIT"
        },
        "platform": "Javascript/Node.js",
        "mode": "daemon",
        "loglevel": "info",
        "icon": "intercom.svg",
        "extIcon": "https://raw.githubusercontent.com/ioBroker/ioBroker.intercom/main/admin/intercom.svg",
        "readme": "https://github.com/ioBroker/ioBroker.intercom/blob/main/README.md",
        "enabled": true,
        "compact": true,
        "messagebox": true,
        "stopBeforeUpdate": true,
        "type": "communication",
        "connectionType": "local",
        "dataSource": "push",
        "tier": 2,
        "adminUI": {
            "config": "json"
        },
        "eraseOnUpload": true,
        "stopTimeout": 10000,
        "restartAdapters": [
            "vis-2"
        ],
        "visWidgets": {
            "vis2IntercomWidgets": {
                "i18n": "component",
                "name": "vis2IntercomWidgets",
                "url": "intercom/customWidgets.js",
                "bundlerType": "module",
                "components": [
                    "Phone"
                ],
                "services": [
                    "PhoneService"
                ]
            }
        },
        "deviceWidgets": {
            "url": "customDevices.js",
            "components": [
                {
                    "name": "IntercomPhoneComponent",
                    "label": {
                        "en": "Phone",
                        "de": "Telefon",
                        "ru": "Телефон",
                        "pt": "Telefone",
                        "nl": "Telefoon",
                        "fr": "Téléphone",
                        "it": "Telefono",
                        "es": "Teléfono",
                        "pl": "Telefon",
                        "uk": "Телефон",
                        "zh-cn": "电话"
                    },
                    "description": {
                        "en": "Phone and door intercom over WebRTC; a small tile opens the whole phone",
                        "de": "Telefon und Türsprechanlage über WebRTC; eine kleine Kachel öffnet das ganze Telefon",
                        "ru": "Телефон и домофон через WebRTC; маленькая плитка открывает весь телефон",
                        "pt": "Telefone e intercomunicador via WebRTC; um mosaico pequeno abre o telefone completo",
                        "nl": "Telefoon en deurintercom via WebRTC; een kleine tegel opent de hele telefoon",
                        "fr": "Téléphone et interphone via WebRTC ; une petite tuile ouvre le téléphone complet",
                        "it": "Telefono e citofono tramite WebRTC; una piccola piastrella apre il telefono intero",
                        "es": "Teléfono e interfono por WebRTC; un mosaico pequeño abre el teléfono completo",
                        "pl": "Telefon i domofon przez WebRTC; mały kafelek otwiera cały telefon",
                        "uk": "Телефон і домофон через WebRTC; маленька плитка відкриває весь телефон",
                        "zh-cn": "通过 WebRTC 的电话和门禁对讲；小磁贴可打开完整电话"
                    },
                    "icon": "intercom.svg"
                }
            ]
        },
        "plugins": {
            "docker": {
                "iobDockerComposeFiles": [
                    "docker-compose.yaml"
                ]
            }
        },
        "dependencies": [
            {
                "js-controller": ">=7.0.0"
            }
        ],
        "globalDependencies": [
            {
                "admin": ">=8.0.0"
            }
        ]
    },
    "encryptedNative": [
        "amiSecret",
        "certPrivate"
    ],
    "protectedNative": [
        "amiSecret",
        "certPrivate",
        "cameras"
    ],
    "native": {
        "configDir": "",
        "dockerEnabled": true,
        "dockerStopOnUnload": false,
        "amiHost": "127.0.0.1",
        "amiPort": 5038,
        "amiSecret": "",
        "wssPort": 8089,
        "rtpStart": 10000,
        "rtpEnd": 20000,
        "stunServer": "",
        "externalAddress": "",
        "iceDenylist": "172.16.0.0/12",
        "codecs": [
            "ulaw",
            "alaw"
        ],
        "videoCodecs": [
            "vp8",
            "h264"
        ],
        "echoTest": true,
        "testPage": true,
        "certSource": "self",
        "certHosts": [],
        "certPublic": "",
        "certPrivate": "",
        "certFingerprint": "",
        "certIobPublic": "",
        "certIobPrivate": "",
        "certIobChained": "",
        "subscribers": [
            {
                "enabled": true,
                "extension": "100",
                "name": "WebRTC",
                "kind": "webrtc",
                "password": "0100"
            },
            {
                "enabled": true,
                "extension": "101",
                "name": "Android (SIP)",
                "kind": "sip",
                "password": "0101"
            }
        ],
        "subscribersPlain": true,
        "asteriskLogLevel": "errors",
        "sipTrace": false,
        "groups": [],
        "cameras": []
    },
    "objects": [],
    "instanceObjects": [
        {
            "_id": "info",
            "type": "channel",
            "common": {
                "name": "Information"
            },
            "native": {}
        },
        {
            "_id": "info.connection",
            "type": "state",
            "common": {
                "name": "Connected to Asterisk (AMI)",
                "type": "boolean",
                "role": "indicator.connected",
                "read": true,
                "write": false,
                "def": false
            },
            "native": {}
        },
        {
            "_id": "info.asteriskVersion",
            "type": "state",
            "common": {
                "name": "Asterisk version",
                "type": "string",
                "role": "text",
                "read": true,
                "write": false,
                "def": ""
            },
            "native": {}
        },
        {
            "_id": "info.certFingerprint",
            "type": "state",
            "common": {
                "name": "SHA-256 fingerprint of the certificate",
                "type": "string",
                "role": "text",
                "read": true,
                "write": false,
                "def": ""
            },
            "native": {}
        },
        {
            "_id": "info.wssUrl",
            "type": "state",
            "common": {
                "name": "WebSocket URL for clients",
                "type": "string",
                "role": "url",
                "read": true,
                "write": false,
                "def": ""
            },
            "native": {}
        },
        {
            "_id": "info.configHash",
            "type": "state",
            "common": {
                "name": "Hash of the configuration applied to Asterisk",
                "type": "string",
                "role": "text",
                "read": true,
                "write": false,
                "def": "",
                "expert": true
            },
            "native": {}
        },
        {
            "_id": "subscribers",
            "type": "folder",
            "common": {
                "name": "Subscribers"
            },
            "native": {}
        }
    ]
}
